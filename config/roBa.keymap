#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        muhennkann {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <13 12>;
        };

        nihongo {
            bindings = <&kp INT_HENKAN>;
            key-positions = <18 19>;
        };

        Bluetooth {
            bindings = <&tog 3>;
            key-positions = <34 42>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_Layer {
            bindings = <
&kp Q           &kp W  &kp E  &kp R         &kp T                                                           &kp Y        &kp U  &kp I  &kp O      &kp P
&mt LCTRL A     &kp S  &kp D  &kp F         &kp G      &kp EQUAL                     &kp HASH               &kp H        &kp J  &kp K  &kp L      &kp SEMICOLON
&mt LCTRL Z     &kp X  &kp C  &kp V         &kp B      &kp MINUS                     &kp SLASH              &kp B        &kp N  &kp M  &kp COMMA  &kp PERIOD
&kp LEFT_SHIFT  &none  &none  &kp LEFT_ALT  &lt 2 TAB  &mt LEFT_SHIFT BACKSPACE      &mt RIGHT_SHIFT SPACE  &lt 1 ENTER                           &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        Right_Layer {
            bindings = <
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL                      &trans  &trans          &trans        &trans          &trans
&trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS  &kp F7      &trans  &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &kp F8      &trans  &trans  &trans          &trans        &trans          &trans
&trans  &kp NUMBER_0  &kp DOT       &trans        &trans     &trans      &trans  &trans                                                &trans
            >;
        };

        Left_Layer {
            bindings = <
&trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                      &kp EQUAL  &kp N7  &kp N8  &kp N9  &trans
&trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans      &trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans      &trans  &kp SLASH  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans                &trans                 &trans  &trans      &trans  &trans                             &kp NUMBER_0
            >;
        };

        Bluetooth_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &trans
            >;
        };

        Mouse_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };
    };
};
